---
import BaseLayout from '../layouts/BaseLayout.astro';
import { extraUi } from '../i18n/extra';
import { homePath, langCodes, languages } from '../i18n/ui';

const x = extraUi.es;
---

<BaseLayout title={x.notFoundTitle} noindex showStickyAd={false}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="text-6xl mb-4">🚐💨</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">{x.notFoundTitle}</h1>
    <p class="mt-3 text-stone-600">{x.notFoundText}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="px-5 py-3 bg-emerald-500 hover:bg-emerald-400 text-stone-950 font-bold rounded-xl text-sm transition">{x.notFoundCta}</a>
      <a href="/blog" class="px-5 py-3 bg-stone-900 hover:bg-stone-800 text-white font-semibold rounded-xl text-sm transition">{x.blogHeading}</a>
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-4 text-sm text-stone-500">
      {langCodes.filter((l) => l !== 'es').map((l) => (
        <li><a href={homePath(l)} hreflang={languages[l].htmlLang} class="hover:text-emerald-700">{languages[l].flag} {extraUi[l].notFoundCta}</a></li>
      ))}
    </ul>
  </div>
</BaseLayout>
