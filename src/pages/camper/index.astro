---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdBanner from '../../components/AdBanner.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.filter(p => p.data.category === 'camper');
---

<BaseLayout 
  title="Guía de Camperización y Bricolaje Furgoneta | RutaFugaz"
  description="Tutoriales prácticos de camperización económica, aislamiento térmico, sistemas eléctricos a 12V y trucos para no tener que homologar en ITV."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header Categoría -->
    <header class="mb-10 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-100 text-amber-800 text-2xl mb-4">
        🛠️
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
        Guía de Camperización
      </h1>
      <p class="mt-3 text-stone-600 leading-relaxed text-sm sm:text-base">
        Aprende a transformar cualquier furgoneta en tu propia casa con ruedas. Proyectos accesibles de bricolaje, planos detallados y listas de compra reales.
      </p>
    </header>

    <AdBanner slotId="category-camper-top" format="horizontal" />

    <!-- Grid de Artículos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
      {posts.map((post) => (
        <article class="bg-white border border-stone-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-lg transition flex flex-col group">
          <a href={`/blog/${post.id}`} class="overflow-hidden aspect-video block">
            <img 
              src={post.data.heroImage} 
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
              loading="lazy"
            />
          </a>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-stone-600 mb-2 font-mono">
                <span>{post.data.readTime}</span>
                <span>{new Intl.DateTimeFormat('es-ES', { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate)}</span>
              </div>
              <h2 class="text-lg font-bold text-stone-900 group-hover:text-emerald-700 transition leading-snug">
                <a href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-xs text-stone-600 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <a 
              href={`/blog/${post.id}`} 
              class="mt-4 inline-flex items-center text-xs font-bold text-emerald-700 hover:text-emerald-900"
            >
              Ver tutorial de camperización →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
