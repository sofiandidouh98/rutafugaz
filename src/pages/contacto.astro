---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contacto y Colaboraciones | RutaFugaz"
  description="Contacta con el equipo editorial de RutaFugaz para dudas sobre rutas, propuestas comerciales o colaboraciones de turismo rural."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6 font-mono">
      <a href="/" class="hover:text-emerald-700 transition">Inicio</a>
      <span>/</span>
      <span class="text-stone-400">Contacto</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
        Ponte en Contacto con Nosotros
      </h1>
      <p class="mt-2 text-stone-600 leading-relaxed">
        ¿Tienes una duda sobre alguna ruta? ¿Quieres avisarnos de un cambio en la normativa de tu municipio? ¿Representas a una marca del sector outdoor? Escríbenos.
      </p>
    </header>

    <div class="bg-white border border-stone-200 rounded-2xl p-6 sm:p-8 shadow-xs">
      <form class="space-y-5" onsubmit="event.preventDefault(); alert('¡Mensaje enviado con éxito! Te responderemos en un plazo máximo de 48 horas laborales.');">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Nombre</label>
            <input 
              type="text" 
              id="name" 
              required 
              placeholder="Tu nombre..."
              class="w-full px-4 py-2.5 bg-stone-50 border border-stone-300 rounded-xl text-stone-900 focus:ring-2 focus:ring-emerald-500 focus:outline-hidden text-sm"
            />
          </div>
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Correo Electrónico</label>
            <input 
              type="email" 
              id="email" 
              required 
              placeholder="tu@correo.com..."
              class="w-full px-4 py-2.5 bg-stone-50 border border-stone-300 rounded-xl text-stone-900 focus:ring-2 focus:ring-emerald-500 focus:outline-hidden text-sm"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Asunto</label>
          <select 
            id="subject"
            class="w-full px-4 py-2.5 bg-stone-50 border border-stone-300 rounded-xl text-stone-900 focus:ring-2 focus:ring-emerald-500 focus:outline-hidden text-sm"
          >
            <option value="consulta">Duda sobre una ruta o pernocta</option>
            <option value="camper">Consulta de camperización / brico</option>
            <option value="publicidad">Prensa, Publicidad & Patrocinios</option>
            <option value="otro">Otro motivo</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-xs font-bold uppercase tracking-wider text-stone-700 mb-1">Mensaje</label>
          <textarea 
            id="message" 
            rows="5" 
            required 
            placeholder="Cuéntanos en qué podemos ayudarte..."
            class="w-full px-4 py-2.5 bg-stone-50 border border-stone-300 rounded-xl text-stone-900 focus:ring-2 focus:ring-emerald-500 focus:outline-hidden text-sm"
          ></textarea>
        </div>

        <div class="flex items-start gap-2 text-xs text-stone-500">
          <input type="checkbox" id="consent" required class="mt-0.5 rounded-sm border-stone-300 text-emerald-600 focus:ring-emerald-500" />
          <label for="consent">
            He leído y acepto la <a href="/politica-de-privacidad" class="text-emerald-700 underline">Política de Privacidad</a> para la gestión de mi consulta.
          </label>
        </div>

        <button 
          type="submit"
          class="w-full sm:w-auto px-8 py-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-xl text-sm transition shadow-sm cursor-pointer"
        >
          Enviar Mensaje
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
