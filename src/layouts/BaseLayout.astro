---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyFooterAd from '../components/StickyFooterAd.astro';
import { siteConfig } from '../config/site';
import { defaultLang, homePath, languages, t, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  articleDate?: Date;
  articleAuthor?: string;
  showStickyAd?: boolean;
  /** Para páginas que no deben aparecer en Google (p. ej. páginas de agradecimiento) */
  noindex?: boolean;
  /** Etiqueta de categoría del artículo (article:section) */
  articleSection?: string;
  articleModified?: Date;
  lang?: Lang;
  /** Ruta de esta misma página en cada idioma (para hreflang y el selector de idioma) */
  alternates?: Partial<Record<Lang, string>>;
}

const { lang = defaultLang, alternates = {} } = Astro.props;
const strings = t(lang);

const {
  title = strings.site.title,
  description = strings.site.description,
  image = 'https://images.unsplash.com/photo-1523987355523-c7b5b0dd90a7?auto=format&fit=crop&w=1200&q=80',
  // URL canónica siempre en el dominio www y sin barra final
  canonicalUrl = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', siteConfig.url).href,
  articleDate,
  articleAuthor,
  articleSection,
  articleModified,
  showStickyAd = true,
  noindex = false,
} = Astro.props;

// Google corta los títulos a ~60 caracteres: solo añadimos la marca si cabe
const fullTitle = title.includes('RutaFugaz') || title.length > 48 ? title : `${title} | RutaFugaz`;
const langInfo = languages[lang];
const alternateEntries = Object.entries(alternates) as [Lang, string][];
---

<!doctype html>
<html lang={langInfo.htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Versiones en otros idiomas (hreflang) -->
    {alternateEntries.map(([l, path]) => (
      <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(path, siteConfig.url).href} />
    ))}
    {alternates[defaultLang] && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.en ?? alternates[defaultLang]!, siteConfig.url).href} />
    )}

    <!-- SEO Básico -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <!-- Open Graph / Facebook / Pinterest / Discover -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:site_name" content="RutaFugaz" />
    <meta property="og:locale" content={langInfo.locale} />
    {alternateEntries.filter(([l]) => l !== lang).map(([l]) => (
      <meta property="og:locale:alternate" content={languages[l].locale} />
    ))}
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    {articleDate && <meta property="article:modified_time" content={(articleModified ?? articleDate).toISOString()} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleAuthor && <meta name="author" content={articleAuthor} />}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google AdSense Script (Listo para producción) -->
    {siteConfig.ads.enableAutoAds && (
      <script 
        async 
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.ads.adSenseClientId}`}
        crossorigin="anonymous">
      </script>
    )}

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "RutaFugaz",
      "url": new URL(homePath(lang), siteConfig.url).href,
      "publisher": {
        "@type": "Organization",
        "name": "RutaFugaz",
        "url": siteConfig.url,
        "logo": { "@type": "ImageObject", "url": `${siteConfig.url}/favicon.svg` }
      },
      "description": strings.site.description,
      "inLanguage": langInfo.dateLocale
    })} />
  </head>
  <body class="bg-stone-50 text-stone-900 min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-white">
    <Header lang={lang} alternates={alternates} />
    
    <main class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />

    {showStickyAd && <StickyFooterAd />}

    <!-- Vercel Web Analytics -->
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </body>
</html>
