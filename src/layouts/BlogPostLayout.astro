---
import BaseLayout from './BaseLayout.astro';
import AdBanner from '../components/AdBanner.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AffiliateDisclaimer from '../components/AffiliateDisclaimer.astro';
import ShareButtons from '../components/ShareButtons.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import { siteConfig } from '../config/site';
import { categoryPath, homePath, languages, postLang, t, type Lang } from '../i18n/ui';

interface Props {
  post: {
    id: string;
    slug?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      author: string;
      category: 'rutas' | 'camper' | 'pernocta' | 'equipamiento';
      heroImage: string;
      readTime: string;
      tags: string[];
    };
  };
  alternates?: Partial<Record<Lang, string>>;
}

const { post, alternates } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, heroImage, readTime, tags } = post.data;

const lang = postLang(post.id);
const strings = t(lang);
const categoryLabels = strings.nav;

const formattedDate = new Intl.DateTimeFormat(languages[lang].dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

const articleUrl = Astro.url.href;

// JSON-LD Schema for BlogPosting (Crucial for Google Discover and News indexing)
const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "inLanguage": languages[lang].dateLocale,
  "image": [heroImage],
  "datePublished": pubDate.toISOString(),
  "dateModified": (updatedDate || pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": author,
    "url": `${siteConfig.url}/sobre-nosotros`
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteConfig.url}/favicon.svg`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl
  }
};
---

<BaseLayout 
  title={title} 
  description={description} 
  image={heroImage} 
  articleDate={pubDate} 
  articleAuthor={author}
  lang={lang}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticle)} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 pt-8 pb-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6 font-mono overflow-x-auto">
      <a href={homePath(lang)} class="hover:text-emerald-700 transition">{strings.post.home}</a>
      <span>/</span>
      <a href={categoryPath(lang, category)} class="hover:text-emerald-700 transition capitalize">
        {categoryLabels[category]}
      </a>
      <span>/</span>
      <span class="text-stone-400 truncate max-w-xs">{title}</span>
    </nav>

    <!-- Header del Artículo -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full bg-emerald-100 text-emerald-800">
          {categoryLabels[category]}
        </span>
        <span class="text-xs text-stone-500 font-medium">⏱️ {readTime}</span>
        <span class="text-xs text-stone-400">•</span>
        <time datetime={pubDate.toISOString()} class="text-xs text-stone-500">
          {strings.post.updated}: {formattedDate}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-stone-900 tracking-tight leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-lg text-stone-600 leading-relaxed font-normal">
        {description}
      </p>

      <!-- Autor & Redes -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 py-4 border-y border-stone-200 text-xs text-stone-600">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-emerald-800 text-amber-200 flex items-center justify-center font-bold text-xs">
            RF
          </div>
          <div>
            <p class="font-bold text-stone-900">{author}</p>
            <p class="text-stone-500">{strings.post.team}</p>
          </div>
        </div>

        <ShareButtons title={title} url={articleUrl} lang={lang} />
      </div>
    </header>

    <!-- Imagen Principal con Relación de Aspecto Optimizada para Google Discover (16:9) -->
    <div class="rounded-2xl overflow-hidden shadow-lg mb-8 border border-stone-200">
      <img 
        src={heroImage} 
        alt={title} 
        class="w-full h-auto aspect-video object-cover" 
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- Anuncio Superior de Alta Visibilidad (Debajo de la foto de cabecera) -->
    <AdBanner slotId="post-top-slot" format="horizontal" />

    <!-- Aviso de Afiliación Transparente -->
    <AffiliateDisclaimer lang={lang} />

    <!-- Contenido Markdown Prosa -->
    <div class="prose prose-stone prose-emerald lg:prose-lg max-w-none 
                prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-stone-900
                prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-stone-200 prose-h2:pb-2
                prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8
                prose-p:leading-relaxed prose-p:text-stone-700
                prose-a:text-emerald-700 prose-a:font-semibold prose-a:underline hover:prose-a:text-emerald-900
                prose-img:rounded-xl prose-img:shadow-md
                prose-table:border-collapse prose-th:bg-stone-100 prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-stone-200">
      <slot />
    </div>

    <!-- Anuncio Inferior (Antes de comentarios/autor) -->
    <AdBanner slotId="post-bottom-slot" format="rectangle" />

    <!-- Tags del Artículo -->
    {tags.length > 0 && (
      <div class="mt-10 pt-6 border-t border-stone-200 flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold text-stone-500 uppercase tracking-wider">{strings.post.tags}</span>
        {tags.map((tag) => (
          <span class="px-2.5 py-1 text-xs bg-stone-100 text-stone-700 rounded-md font-mono hover:bg-stone-200 transition">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Caja de Autor (E-E-A-T) -->
    <AuthorBox author={author} lang={lang} />

    <!-- Magnet Newsletter para fidelizar visitas -->
    <div id="boletin"><NewsletterBox lang={lang} /></div>
  </article>
</BaseLayout>
