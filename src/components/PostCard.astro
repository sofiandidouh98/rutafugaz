---
import type { Post } from '../i18n/posts';
import { resizeImage } from '../i18n/extra';
import { categoryColors, languages, postLang, postPath, t } from '../i18n/ui';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h3' } = Astro.props;
const lang = postLang(post.id);
const strings = t(lang);
const href = postPath(post.id);
const Heading = headingLevel;
const date = new Intl.DateTimeFormat(languages[lang].dateLocale, { month: 'short', day: 'numeric', year: 'numeric' }).format(post.data.pubDate);
---

<article class="bg-white border border-stone-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-lg transition flex flex-col group">
  <a href={href} class="overflow-hidden aspect-video block" tabindex="-1" aria-hidden="true">
    <img
      src={resizeImage(post.data.heroImage, 640)}
      alt={post.data.title}
      width="640"
      height="360"
      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center justify-between gap-2 text-xs text-stone-600 mb-2 font-mono">
        <span class={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-sm font-semibold ${categoryColors[post.data.category]}`}>
          {strings.nav[post.data.category]}
        </span>
        <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      </div>
      <Heading class="text-lg font-bold text-stone-900 group-hover:text-emerald-700 transition leading-snug">
        <a href={href}>{post.data.title}</a>
      </Heading>
      <p class="mt-2 text-xs text-stone-600 line-clamp-3 leading-relaxed">
        {post.data.description}
      </p>
    </div>
    <div class="mt-4 flex items-center justify-between text-xs">
      <span class="text-stone-500">{post.data.readTime}</span>
      <a href={href} class="font-bold text-emerald-700 hover:text-emerald-900">{strings.category.readFull}</a>
    </div>
  </div>
</article>
