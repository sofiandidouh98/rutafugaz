---
import { categoryKeys, categoryPath, defaultLang, homePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const strings = t(lang);
const es = lang === defaultLang;
// Las páginas legales e institucionales solo existen en español
const esNote = es ? '' : ` ${strings.footer.spanishOnly}`;

const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-950 text-stone-400 border-t border-stone-800 pt-16 pb-28 md:pb-20 text-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-4 gap-10">
    <!-- Columna 1: Brand & Misión -->
    <div class="md:col-span-1 space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-2xl">🏕️</span>
        <span class="text-lg font-bold text-white tracking-tight">RutaFugaz</span>
      </div>
      <p class="text-xs text-stone-400 leading-relaxed">
        {strings.footer.mission}
      </p>
      <div class="pt-2 text-xs text-stone-500 font-mono">
        Made with ❤️ for outdoor lovers.
      </div>
    </div>

    <!-- Columna 2: Silos Temáticos -->
    <div>
      <h4 class="text-xs font-bold text-stone-200 uppercase tracking-wider mb-3 font-mono">
        {strings.footer.categories}
      </h4>
      <ul class="space-y-2 text-xs">
        {categoryKeys.map((cat) => (
          <li><a href={categoryPath(lang, cat)} class="hover:text-emerald-400 transition">{strings.categories[cat].name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Columna 3: Información & Autoridad -->
    <div>
      <h4 class="text-xs font-bold text-stone-200 uppercase tracking-wider mb-3 font-mono">
        {strings.footer.project}
      </h4>
      <ul class="space-y-2 text-xs">
        <li><a href="/sobre-nosotros" class="hover:text-emerald-400 transition">{strings.footer.about}{esNote}</a></li>
        <li><a href="/contacto" class="hover:text-emerald-400 transition">{strings.footer.contact}{esNote}</a></li>
        <li><a href={`${homePath(lang)}#boletin`} class="hover:text-emerald-400 transition">{strings.footer.freeMap}</a></li>
        <li><a href="/sitemap-index.xml" class="hover:text-emerald-400 transition">{strings.footer.sitemap}</a></li>
      </ul>
    </div>

    <!-- Columna 4: Legal & Transparencia (Requerido por Google AdSense) -->
    <div>
      <h4 class="text-xs font-bold text-stone-200 uppercase tracking-wider mb-3 font-mono">
        {strings.footer.legal}
      </h4>
      <ul class="space-y-2 text-xs">
        <li><a href="/aviso-legal" class="hover:text-emerald-400 transition">{strings.footer.legalNotice}{esNote}</a></li>
        <li><a href="/politica-de-privacidad" class="hover:text-emerald-400 transition">{strings.footer.privacy}{esNote}</a></li>
        <li><a href="/politica-de-cookies" class="hover:text-emerald-400 transition">{strings.footer.cookies}{esNote}</a></li>
      </ul>
      <p class="mt-4 text-[11px] text-stone-500 leading-tight">
        {strings.footer.monetization}
      </p>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 mt-12 pt-8 border-t border-stone-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-500 gap-4">
    <p>© {currentYear} RutaFugaz. {strings.footer.rights}</p>
    <p class="font-mono text-[11px]">Designed for speed & Core Web Vitals 100/100</p>
  </div>
</footer>
