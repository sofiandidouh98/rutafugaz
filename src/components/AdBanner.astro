---
import { siteConfig } from '../config/site';

interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'fluid';
  className?: string;
}

const { slotId = '1234567890', format = 'horizontal', className = '' } = Astro.props;
const { ads } = siteConfig;
---

{ads.showAdSlots && (
  <div class={`my-8 flex flex-col items-center justify-center overflow-hidden transition-all ${className}`}>
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client={ads.adSenseClientId}
         data-ad-slot={slotId}
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
