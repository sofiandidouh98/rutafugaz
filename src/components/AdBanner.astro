---
import { siteConfig } from '../config/site';

interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'fluid';
  className?: string;
}

const { slotId = '1234567890', format = 'horizontal', className = '' } = Astro.props;
const { ads } = siteConfig;
---

<div class={`my-8 flex flex-col items-center justify-center overflow-hidden transition-all ${className}`}>
  <span class="text-[10px] uppercase tracking-wider text-stone-600 mb-1 font-mono font-medium">Publicidad</span>
  
  <div class="w-full max-w-4xl min-h-[100px] md:min-h-[120px] bg-stone-100 border border-dashed border-stone-300 rounded-xl flex flex-col items-center justify-center p-4 text-center">
    {ads.showPlaceholders ? (
      <div class="text-stone-500">
        <p class="text-xs font-semibold text-stone-600 uppercase tracking-wide">Espacio Publicitario Banner ({format})</p>
        <p class="text-[11px] text-stone-400 mt-0.5">Google AdSense / Mediavine Slot ID: {slotId}</p>
        <span class="inline-block mt-2 px-2.5 py-1 bg-amber-100 text-amber-800 text-[10px] font-medium rounded-full">
          Optimizado para Viewability & Core Web Vitals
        </span>
      </div>
    ) : (
      <div>
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client={ads.adSenseClientId}
             data-ad-slot={slotId}
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script is:inline>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    )}
  </div>
</div>
