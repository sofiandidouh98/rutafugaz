---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../PostCard.astro';
import { getPostsByLang } from '../../i18n/posts';
import { extraUi } from '../../i18n/extra';
import { categoryKeys, categoryPath, langCodes, langPrefix, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const x = extraUi[lang];
const posts = await getPostsByLang(lang);
const alternates = Object.fromEntries(langCodes.map((l) => [l, `${langPrefix(l)}/blog`]));
---

<BaseLayout title={x.blogTitle} description={x.blogDescription} lang={lang} alternates={alternates}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-8 text-center max-w-2xl mx-auto">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">{x.blogHeading}</h1>
      <p class="mt-3 text-stone-600 leading-relaxed text-sm sm:text-base">{x.blogDescription}</p>
    </header>

    <nav class="flex flex-wrap justify-center gap-2 mb-10">
      {categoryKeys.map((cat) => (
        <a href={categoryPath(lang, cat)} class="px-3 py-1.5 text-xs font-semibold bg-white border border-stone-200 rounded-full hover:border-emerald-500 hover:text-emerald-700 transition">
          {strings.categories[cat].name}
        </a>
      ))}
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => <PostCard post={post} headingLevel="h2" />)}
    </div>
  </div>
</BaseLayout>
