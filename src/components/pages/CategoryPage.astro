---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdBanner from '../AdBanner.astro';
import PostCard from '../PostCard.astro';
import { getPostsByLang } from '../../i18n/posts';
import { categoryColors, categoryIcons, categoryPath, langCodes, t, type CategoryKey, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  category: CategoryKey;
}

const { lang, category } = Astro.props;
const strings = t(lang);
const c = strings.categories[category];

const posts = (await getPostsByLang(lang)).filter(p => p.data.category === category);
const alternates = Object.fromEntries(langCodes.map((l) => [l, categoryPath(l, category)]));
---

<BaseLayout
  title={c.title}
  description={c.metaDescription}
  lang={lang}
  alternates={alternates}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header Categoría -->
    <header class="mb-10 text-center max-w-2xl mx-auto">
      <div class={`inline-flex items-center justify-center w-14 h-14 rounded-2xl ${categoryColors[category]} text-2xl mb-4`}>
        {categoryIcons[category]}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
        {c.heading}
      </h1>
      <p class="mt-3 text-stone-600 leading-relaxed text-sm sm:text-base">
        {c.intro}
      </p>
    </header>

    <AdBanner slotId={`category-${category}-top`} format="horizontal" />

    <!-- Grid de Artículos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
      {posts.map((post) => <PostCard post={post} headingLevel="h2" />)}
    </div>
  </div>
</BaseLayout>
