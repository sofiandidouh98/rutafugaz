---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdBanner from '../AdBanner.astro';
import { getPostsByLang } from '../../i18n/posts';
import { categoryColors, categoryIcons, categoryPath, langCodes, languages, postPath, t, type CategoryKey, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  category: CategoryKey;
}

const { lang, category } = Astro.props;
const strings = t(lang);
const c = strings.categories[category];

const posts = (await getPostsByLang(lang)).filter(p => p.data.category === category);
const alternates = Object.fromEntries(langCodes.map((l) => [l, categoryPath(l, category)]));
const dateFormat = new Intl.DateTimeFormat(languages[lang].dateLocale, { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title={c.title}
  description={c.metaDescription}
  lang={lang}
  alternates={alternates}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header Categoría -->
    <header class="mb-10 text-center max-w-2xl mx-auto">
      <div class={`inline-flex items-center justify-center w-14 h-14 rounded-2xl ${categoryColors[category]} text-2xl mb-4`}>
        {categoryIcons[category]}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
        {c.heading}
      </h1>
      <p class="mt-3 text-stone-600 leading-relaxed text-sm sm:text-base">
        {c.intro}
      </p>
    </header>

    <AdBanner slotId={`category-${category}-top`} format="horizontal" />

    <!-- Grid de Artículos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
      {posts.map((post) => (
        <article class="bg-white border border-stone-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-lg transition flex flex-col group">
          <a href={postPath(post.id)} class="overflow-hidden aspect-video block">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
              loading="lazy"
            />
          </a>
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-stone-600 mb-2 font-mono">
                <span>{post.data.readTime}</span>
                <span>{dateFormat.format(post.data.pubDate)}</span>
              </div>
              <h2 class="text-lg font-bold text-stone-900 group-hover:text-emerald-700 transition leading-snug">
                <a href={postPath(post.id)}>
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 text-xs text-stone-600 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <a
              href={postPath(post.id)}
              class="mt-4 inline-flex items-center text-xs font-bold text-emerald-700 hover:text-emerald-900"
            >
              {strings.category.readFull}
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
