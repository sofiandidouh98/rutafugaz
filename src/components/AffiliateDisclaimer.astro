---
import { defaultLang, t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const strings = t(lang).post;
---
<div class="mb-6 p-3.5 bg-stone-100/80 border-l-4 border-emerald-600 rounded-r-lg text-xs text-stone-600">
  <p class="leading-relaxed">
    <strong class="font-semibold text-stone-800">{strings.disclaimerStrong}</strong> 
    {strings.disclaimer}
  </p>
</div>
