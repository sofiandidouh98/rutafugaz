---
import { categoryKeys, categoryPath, defaultLang, homePath, langCodes, languages, t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { lang = defaultLang, alternates = {} } = Astro.props;
const strings = t(lang);

const navItems = categoryKeys.map((cat) => ({ href: categoryPath(lang, cat), label: strings.nav[cat] }));
const current = languages[lang];
---

<header class="sticky top-0 z-40 bg-stone-900/95 backdrop-blur-md border-b border-stone-800 text-stone-100 shadow-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={homePath(lang)} class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-emerald-600 text-amber-200 flex items-center justify-center font-bold text-xl group-hover:scale-105 transition shadow-md shadow-emerald-950/50">
        🏕️
      </div>
      <div>
        <span class="text-xl font-extrabold tracking-tight text-white group-hover:text-emerald-400 transition">
          Ruta<span class="text-emerald-400">Fugaz</span>
        </span>
        <span class="hidden sm:block text-[10px] text-stone-400 font-mono tracking-widest uppercase -mt-1">
          {strings.site.tagline}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a 
          href={item.href}
          class="px-3.5 py-1.5 text-sm font-medium text-stone-300 hover:text-white hover:bg-stone-800/80 rounded-lg transition"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right Side CTA / Badges -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Selector de idioma -->
      <details class="relative group/lang" id="lang-switcher">
        <summary
          class="list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-stone-200 rounded-lg transition border border-stone-700"
          aria-label={strings.header.language}
        >
          <span>{current.flag}</span>
          <span class="uppercase font-mono">{lang}</span>
          <span class="text-[9px] text-stone-400">▼</span>
        </summary>
        <ul class="absolute right-0 mt-2 w-44 py-1.5 bg-stone-900 border border-stone-700 rounded-xl shadow-xl z-50">
          {langCodes.map((l) => (
            <li>
              <a
                href={alternates[l] ?? homePath(l)}
                hreflang={languages[l].htmlLang}
                lang={languages[l].htmlLang}
                data-set-lang={l}
                class={`flex items-center gap-2.5 px-3.5 py-2 text-sm transition ${l === lang ? 'text-emerald-400 font-bold' : 'text-stone-300 hover:bg-stone-800 hover:text-white'}`}
              >
                <span>{languages[l].flag}</span>
                <span>{languages[l].name}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>

      {lang === defaultLang && (
        <a 
          href="/sobre-nosotros"
          class="hidden lg:inline-flex items-center text-xs font-semibold px-3 py-1.5 bg-stone-800 hover:bg-stone-700 text-stone-300 rounded-lg transition border border-stone-700"
        >
          {strings.header.editorial}
        </a>
      )}
      <a 
        href="#boletin"
        class="inline-flex items-center gap-1 text-xs font-bold px-3.5 py-1.5 bg-emerald-500 hover:bg-emerald-400 text-stone-950 rounded-lg transition shadow-xs"
      >
        <span>{strings.header.freeMap}</span>
      </a>
    </div>
  </div>

  <!-- Mobile Secondary Menu Bar -->
  <div class="md:hidden overflow-x-auto flex items-center gap-2 px-4 py-2 border-t border-stone-800/60 bg-stone-950/80 text-xs no-scrollbar">
    {navItems.map((item) => (
      <a 
        href={item.href}
        class="shrink-0 px-2.5 py-1 text-stone-300 bg-stone-900 border border-stone-800 rounded-md active:bg-emerald-900/50"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script is:inline>
  // Recuerda el idioma elegido manualmente para que el middleware no vuelva a redirigir
  document.addEventListener('click', function (e) {
    var link = e.target.closest && e.target.closest('[data-set-lang]');
    if (link) {
      document.cookie = 'rf_lang=' + link.getAttribute('data-set-lang') + '; path=/; max-age=31536000; samesite=lax';
    }
  });
  // Cierra el selector al hacer clic fuera
  document.addEventListener('click', function (e) {
    var sw = document.getElementById('lang-switcher');
    if (sw && sw.open && !sw.contains(e.target)) sw.open = false;
  });
</script>
